{
  "name": "bulwark-relay",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Push notification relay for Bulwark Webmail. Accepts JMAP StateChange and EmailPush bodies and forwards them as FCM / Web Push pings so self-hosters don't need their own Firebase project.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
